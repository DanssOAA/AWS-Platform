# Solo para Supabase Edge Functions. Nunca usar el prefijo VITE_ para estos valores.
# SOLO flujo histórico cloudops-auth; el flujo OTP/aprobación no usa estos dos valores.
CLOUDOPS_ACCESS_CODE=
# Cuentas dedicadas exclusivamente a la demostración, separadas por comas.
CLOUDOPS_DEMO_EMAILS=
# Lista completa de orígenes para solicitud/aprobación/OTP, separada por comas.
# Si se deja vacía, permite localhost:5173 y cloudops-dashboard-blue.vercel.app.
CLOUDOPS_ALLOWED_ORIGINS=
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY son provistos por Supabase.
